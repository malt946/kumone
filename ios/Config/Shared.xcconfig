// Shared.xcconfig
// 光遇身高查询（iOS）共享构建配置。

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = KumoneIOS
// 占位 Bundle ID，后续替换为你自己的标识。
PRODUCT_BUNDLE_IDENTIFIER = com.example.skyheight
// Home Screen 名称来自 CFBundleDisplayName。
INFOPLIST_KEY_CFBundleDisplayName = 光遇身高
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 16.0

// 仅 iPhone。
TARGETED_DEVICE_FAMILY = 1

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
// 启动屏在 Config/Info.plist 中以 `UILaunchScreen` 显式声明。
// 请勿重新加入 INFOPLIST_KEY_UILaunchScreen_Generation（会生成错误的嵌套值）。
KUMONE_INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait

// ==========================================
// Entitlements
// ==========================================
KUMONE_ENTITLEMENTS_FILE = Config/KumoneIOS.entitlements

INFOPLIST_FILE = $(KUMONE_INFOPLIST_FILE)
CODE_SIGN_ENTITLEMENTS = $(KUMONE_ENTITLEMENTS_FILE)
